@using SolarK64.Models.Entities;
@{

    ViewData["title"] = "Trang chủ";
}
<section class="hero-section">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-7">
                <div class="content-box">
                    <div class="logo-wrap" style="display: table;width: 100%;margin-bottom: 20px;">
                        <a href="/">
                            <img src="./asset/image/logo.png?v=1" alt="" class="logo" style="width: 231px;">
                        </a>
                        <img src="./asset/image/Layer-37.png" alt="" class="logo logo-reponsive" style="float: right;">
                    </div>
                    <div class="box-title">
                        <h1 class="title">Save Up to $300 a Month on Your Electric Bills</h1>
                        <p class="sub-title">Get your free quote from local installers in just 3 minutes</p>
                        <ul class="list-content">
                            <li>Get a Free solar savings report</li>
                            <li>See your personalized costs & savings</li>
                            <li>Check out incentives in your state</li>
                            <li>Compare prices from local installers</li>
                        </ul>
                    </div>
                    <div class="row justify-content-center justify-content-lg-start  gy-4">
                        <div class="btn-box">
                            <a href="https://www.bz2atrk.com/7QDDDL/R74QP/" class="btn" target="_blank">Get your Free Quote Now</a>
                            <p>100% Free, No obligation, Takes only 30 seconds</p>
                        </div>
                        <div class="star-box">
                            <p>Rated 4.9/5 from 53,709 reviews</p>
                            <img src="./asset/image/box-star.png" alt="" class="img">
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-5">
                <div class="logo-wrap logo-wrap-pc">
                    <img src="./asset/image/Layer-37.png" alt="" class="logo" style="float: right;">
                </div>
                <div class="slide-box">
                    <div class="title-box">
                        <h2 class="title">
                            Real Customer, <br>
                            Real Result
                        </h2>
                    </div>
                    <div class="swiper-container slide">
                        <div class="swiper-wrapper">
                            @{
                                if (ViewData["lstPhanHoi"] != null)
                                {
                                    foreach (PhanHoi phanHoi in ViewBag.lstPhanHoi)
                                    {
                                        <div class="swiper-slide testimonial-card">
                                            <div class="slide-item testimonial-content">
                                                <div class="info-box">
                                                    <div class="avt-wrap"><img src="./asset/image/@phanHoi.AnhDaiDien" alt="" class="img"></div>
                                                    <div class="box-name">
                                                        <p class="name">@phanHoi.HoVaTen</p>
                                                        <div class="star-box">
                                                            @{
                                                                for (int i = 0; i < phanHoi.DiemDanhGia; i++)
                                                                {
                                                                    <img src="./asset/image/star.png" alt="" class="star">
                                                                }
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                <p>@phanHoi.NhanXet</p>
                                            </div>
                                        </div>
                                    }
                                }
                            }
                        </div>

                        <!-- Add Navigation Arrows -->
                        <!-- <div class="swiper-button-next"></div>
                        <div class="swiper-button-prev"></div> -->
                        <div class="panigation">
                            <button class="prev-slide"><img src="./asset/image/prev-slide.svg" alt=""></button>
                            <button class="next-slide"><img src="./asset/image/next-slide.svg" alt=""></button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
